# Copy this file to staging.tfvars or production.tfvars.
# Do not put AWS keys, database passwords, JWT secrets, or Docker Hub tokens here.

environment       = "staging"
aws_region        = "ap-southeast-2"
api_image         = "docker.io/YOUR_DOCKERHUB_USERNAME/placeholder-store:backend-COMMIT_SHA"
frontend_image    = "docker.io/YOUR_DOCKERHUB_USERNAME/placeholder-store:frontend-staging-COMMIT_SHA"
certificate_arn   = "arn:aws:acm:ap-southeast-2:AWS_ACCOUNT_ID:certificate/CERTIFICATE_ID"

frontend_host = "staging.placeholder-store.site"
api_host      = "staging-api.placeholder-store.site"
uptime_host   = "staging-monitor.placeholder-store.site"

# Optional; currently reserved for notification configuration.
alert_email = "ops@example.invalid"
