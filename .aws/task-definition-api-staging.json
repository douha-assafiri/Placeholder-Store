{
  "family": "placeholder-store-api-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "set-by-cd-workflow",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "JWT_ALGORITHM", "value": "HS256" },
        { "name": "JWT_EXPIRATION", "value": "3600" }
      ],
      "secrets": [
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:AWS_ACCOUNT_ID:secret:TODO_STAGING_JWT_SECRET_NAME" },
        { "name": "DB_URL", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:AWS_ACCOUNT_ID:secret:TODO_STAGING_DB_URL_SECRET_NAME" },
        { "name": "ADMIN_EMAIL", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:AWS_ACCOUNT_ID:secret:TODO_STAGING_ADMIN_EMAIL_SECRET_NAME" },
        { "name": "ADMIN_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:AWS_ACCOUNT_ID:secret:TODO_STAGING_ADMIN_PASSWORD_SECRET_NAME" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/placeholder-store-api-staging",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
